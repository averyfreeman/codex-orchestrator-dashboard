---
const title = "Synthetic dashboard preview";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <style>
      :root{font-family:Arial,Helvetica,sans-serif;color:#202733;background:#f4f6f8;font-synthesis:none}*{box-sizing:border-box}body{margin:0;font-size:14px}.shell{min-height:100vh;display:flex}.sidebar{width:230px;flex:none;background:#171d26;color:#fff;padding:24px 14px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:11px;padding:0 9px 36px}.brand-icon{width:30px;height:30px;border-radius:9px;background:#25352f;display:flex;align-items:flex-end;justify-content:center;gap:3px;padding:7px}.brand-icon i{width:4px;border-radius:4px;background:#4de0ad}.brand-icon i:nth-child(1){height:8px}.brand-icon i:nth-child(2){height:14px}.brand-icon i:nth-child(3){height:11px}.brand b{font-size:11px;letter-spacing:1.8px}.brand small{display:block;color:#84909e;font-size:8px;letter-spacing:1.5px;margin-top:4px}.side-label{color:#7e8997;font-size:9px;letter-spacing:1.4px;font-weight:700;padding:0 10px 9px}.workspace{height:40px;display:flex;align-items:center;gap:8px;padding:0 10px;background:#232b36;border:1px solid #303a47;border-radius:7px;color:#e5eaf0;font-size:11px}.workspace i{width:7px;height:7px;border-radius:50%;background:#54d6a4}.views{margin-top:26px}.nav{display:flex;align-items:center;gap:10px;padding:10px;border-radius:6px;color:#9aa4b2;font-size:11px;margin:3px 0}.nav.active{background:#252e3a;color:#fff;box-shadow:inset 2px 0 #4ed6a4}.nav em{width:17px;text-align:center;color:#91a0ac;font-style:normal;font-size:14px}.nav strong{margin-left:auto;font-size:9px;font-weight:500;color:#a7b1bd}.sidebar-spacer{flex:1}.sidebar-status{border-top:1px solid #2a333e;padding:14px 10px 0;color:#a9b2bd;font-size:10px;line-height:1.8}.sidebar-status small{display:block;padding-left:15px;color:#788492;font-size:9px}.pulse{display:inline-block;width:6px;height:6px;border-radius:50%;background:#4ad2a0;margin-right:8px}.main{min-width:0;flex:1}.topbar{height:62px;background:#fff;border-bottom:1px solid #e7ebef;display:flex;align-items:center;justify-content:space-between;padding:0 34px;color:#8a949e;font-size:11px}.topbar strong{color:#48515d;font-weight:600}.topbar button{border:1px solid #e1e6eb;border-radius:6px;background:#fff;color:#626d78;padding:7px 10px;font:inherit;font-size:10px}.content{max-width:1360px;margin:0 auto;padding:27px 34px 24px}.banner{display:flex;align-items:center;gap:8px;border:1px solid #ead8aa;background:#fff8e8;color:#876b35;border-radius:7px;padding:9px 12px;font-size:10px;font-weight:700;letter-spacing:.45px;margin-bottom:19px}.banner span{font-size:14px}.heading{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px}.eyebrow{color:#84909c;font-size:9px;font-weight:700;letter-spacing:1.5px}.eyebrow i{display:inline-block;width:16px;height:1px;background:#40c89a;vertical-align:middle;margin-right:7px}.heading h1{font-size:24px;letter-spacing:-.6px;margin:8px 0 5px}.heading p{font-size:11px;color:#8b949f;margin:0}.live{font-size:9px;letter-spacing:.8px;color:#32a97f;font-weight:700;padding-bottom:3px}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px;margin-bottom:22px}.kpi{background:#fff;border:1px solid #e7ebef;border-radius:8px;padding:14px 16px}.label{font-size:8px;color:#89929d;font-weight:700;letter-spacing:.8px}.value{font-size:24px;font-weight:650;margin:8px 0 3px;letter-spacing:-.5px}.mint{color:#22a77d}.lavender{color:#8773d8}.amber{color:#ce963c}.blue{color:#5286db}.hint{font-size:9px;color:#a3abb4}.sectionbar{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #dde3e8;margin-bottom:12px}.tabs{display:flex;gap:19px}.tabs span{font-size:10px;color:#8a949e;padding:8px 1px 10px}.tabs span:first-child{color:#28313b;font-weight:650;border-bottom:2px solid #31bd8b}.search{height:28px;border:1px solid #e2e7eb;background:#fff;border-radius:6px;color:#9aa2ab;padding:6px 9px;font-size:9px}.panel{background:#fff;border:1px solid #e7ebef;border-radius:9px;padding:16px}.panelhead{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:13px}.panelhead h2{font-size:12px;margin:0 0 5px}.panelhead p{font-size:10px;color:#8b949f;margin:0}.count{font-size:8px;letter-spacing:.7px;color:#929ba5;border:1px solid #e7ebee;border-radius:4px;padding:5px 7px}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.host{border:1px solid #e9edf0;border-radius:8px;padding:12px}.hosttop{display:flex;align-items:center;gap:9px}.mark{width:28px;height:28px;border-radius:7px;display:grid;place-items:center;background:#e7f7f1;color:#249a73;font-size:10px;font-weight:700}.mark.down{background:#f0f2f4;color:#9ba3ad}.hosttitle{flex:1}.hosttitle b{display:block;font-size:11px}.hosttitle small{display:block;font-size:9px;color:#9aa2ab;margin-top:3px}.health{font-size:9px;color:#268d6d;white-space:nowrap}.health i{display:inline-block;width:6px;height:6px;border-radius:50%;background:#38bd8c;margin-right:5px}.health.offline{color:#9a7070}.health.offline i{background:#d87570}.addresses{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:10px 0 8px;margin-top:10px;border-top:1px solid #eff1f3;border-bottom:1px solid #eff1f3}.addresses div{min-width:0}.addresses span{display:block;font-size:7px;color:#a1a9b1;letter-spacing:.55px;margin-bottom:4px}.addresses code{font-size:8px;color:#626d78;white-space:nowrap}.details{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding-top:8px;color:#9099a3;font-size:8px}.details button{margin-left:auto;border:1px solid #e7ebee;border-radius:4px;background:#f5f6f7;color:#9aa2ab;font-size:8px;padding:4px 7px}.note{display:flex;gap:7px;margin-top:12px;color:#9aa2ab;font-size:8px;line-height:1.5}.note b{width:12px;height:12px;flex:none;display:grid;place-items:center;border:1px solid #bdc6ce;border-radius:50%;font-size:7px}.activity{margin-top:17px;background:#fff;border:1px solid #e7ebef;border-radius:9px;padding:14px 16px 8px}.activityhead{display:flex;justify-content:space-between;margin-bottom:8px}.activityhead b{font-size:11px}.activityhead small{font-size:8px;color:#8b949f}.row{display:flex;align-items:center;gap:9px;border-top:1px solid #f0f2f4;padding:8px 1px;font-size:9px;color:#5b6570}.row i{width:6px;height:6px;border-radius:50%;background:#45bf91;box-shadow:0 0 0 4px #e6f6ef}.row small{margin-left:auto;color:#929ca6;font-size:8px}.footer{display:flex;justify-content:space-between;padding:14px 1px 0;color:#a6adb5;font-size:7px;letter-spacing:.7px}.synthetic{position:fixed;right:13px;bottom:12px;border:1px solid #e5d19b;border-radius:20px;background:#fff7df;color:#7e6432;padding:7px 10px;font-size:8px;font-weight:700;letter-spacing:.5px;box-shadow:0 2px 8px #18212c12;z-index:2}
      @media(max-width:900px){.sidebar{width:180px;padding-left:10px;padding-right:10px}.content{padding:23px 20px}.topbar{padding:0 20px}.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.cards{grid-template-columns:1fr}}
      @media(max-width:620px){body{font-size:13px}.sidebar{width:54px;padding:15px 6px}.brand{padding:0 5px 27px}.brand>div:last-child,.side-label,.workspace,.nav:not(.active),.nav strong,.sidebar-status{display:none}.nav{justify-content:center;padding:11px 2px;font-size:0}.nav em{font-size:15px}.topbar{height:52px;padding:0 11px;font-size:9px}.topbar button{font-size:9px;padding:6px 7px}.content{padding:17px 10px 19px}.banner{font-size:8px;padding:8px;margin-bottom:15px}.heading{align-items:flex-start}.heading h1{font-size:19px}.heading p{max-width:225px;font-size:9px;line-height:1.45}.live{display:none}.kpis{gap:7px;margin-bottom:17px}.kpi{padding:10px}.label{font-size:7px}.value{font-size:20px}.hint{font-size:8px}.sectionbar{display:block}.tabs{gap:11px;overflow:hidden}.tabs span{font-size:8px;white-space:nowrap}.search{width:100%;margin:7px 0 9px}.panel{padding:11px 9px}.panelhead h2{font-size:11px}.panelhead p{max-width:220px;line-height:1.4}.count{font-size:7px}.host{padding:10px}.addresses code{font-size:7px}.details{gap:7px;font-size:7px}.activity{padding:12px 10px}.activityhead small{font-size:7px}.row{font-size:8px}.row small{font-size:7px}.footer{font-size:6px}.synthetic{right:7px;bottom:7px;font-size:7px;padding:6px 8px}}
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar" aria-label="Synthetic dashboard navigation">
        <div class="brand"><div class="brand-icon" aria-hidden="true"><i></i><i></i><i></i></div><div><b>FIELDNOTE</b><small>CODEX FLEET</small></div></div>
        <div class="side-label">WORKSPACE</div><div class="workspace"><i></i> Orchestrator <span style="margin-left:auto;color:#86909d">⌄</span></div>
        <div class="side-label views">VIEWS</div>
        <div class="nav active"><em aria-hidden="true">◉</em> App-server fleet <strong>3</strong></div>
        <div class="nav"><em aria-hidden="true">▦</em> Herdr sessions <strong>4</strong></div>
        <div class="nav"><em aria-hidden="true">⌘</em> Treehouse <strong>6</strong></div>
        <div class="nav"><em aria-hidden="true">◎</em> OpenClaw <strong>8</strong></div>
        <div class="nav"><em aria-hidden="true">✳</em> Control <strong>Codex</strong></div>
        <div class="sidebar-spacer"></div><div class="sidebar-status"><span class="pulse"></span>Polling every 30 sec<small>ZeroTier first · Tailscale fallback</small></div>
      </aside>
      <main class="main">
        <header class="topbar"><div>Workspace <span style="padding:0 8px">/</span> <strong>App-server fleet</strong></div><button type="button" disabled aria-disabled="true">Refresh preview</button></header>
        <div class="content">
          <div class="banner"><span aria-hidden="true">ⓘ</span> SYNTHETIC DATA · STATIC PREVIEW · NO LIVE CONNECTIONS OR CONTROL ACTIONS</div>
          <div class="heading"><div><div class="eyebrow"><i></i> FLEET OVERVIEW</div><h1>App-server fleet</h1><p>Health, versions, and network routes across your Codex hosts.</p></div><div class="live">●&nbsp; SYNTHETIC SNAPSHOT</div></div>
          <section class="kpis" aria-label="Synthetic fleet summary">
            <article class="kpi"><div class="label">HOSTS RESPONDING</div><div class="value mint">3 <span style="color:#929ba5;font-size:14px;font-weight:400">/ 4</span></div><div class="hint">75% of configured fleet</div></article>
            <article class="kpi"><div class="label">ACTIVE AGENTS</div><div class="value lavender">4</div><div class="hint">Across two Herdr servers</div></article>
            <article class="kpi"><div class="label">REGISTERED WORKTREES</div><div class="value amber">6</div><div class="hint">Across three repositories</div></article>
            <article class="kpi"><div class="label">LAST SNAPSHOT</div><div class="value blue">12s</div><div class="hint">Synthetic timestamp</div></article>
          </section>
          <div class="sectionbar"><div class="tabs" aria-label="Static dashboard view tabs"><span>App-server fleet</span><span>Herdr</span><span>Treehouse</span><span>OpenClaw</span></div><div class="search" aria-hidden="true">⌕&nbsp; Search synthetic hosts</div></div>
          <section class="panel" aria-labelledby="host-list-title">
            <div class="panelhead"><div><h2 id="host-list-title">Configured Codex hosts</h2><p>Connectivity, version, Remote Control, and selected transport.</p></div><span class="count">4 SYNTHETIC HOSTS</span></div>
            <div class="cards">
              <article class="host"><div class="hosttop"><span class="mark">C</span><div class="hosttitle"><b>cedar-01</b><small>Linux · sample worker</small></div><span class="health"><i></i>Responding</span></div><div class="addresses"><div><span>LAN</span><code>192.0.2.21</code></div><div><span>TAILSCALE</span><code>198.51.100.21</code></div><div><span>ZEROTIER</span><code>203.0.113.21</code></div></div><div class="details"><span>Codex 0.134.0</span><span>RC enabled</span><span>2 loaded</span><span>Via ZeroTier</span></div></article>
              <article class="host"><div class="hosttop"><span class="mark">H</span><div class="hosttitle"><b>harbor-02</b><small>Linux · sample worker</small></div><span class="health"><i></i>Responding</span></div><div class="addresses"><div><span>LAN</span><code>192.0.2.22</code></div><div><span>TAILSCALE</span><code>198.51.100.22</code></div><div><span>ZEROTIER</span><code>203.0.113.22</code></div></div><div class="details"><span>Codex 0.134.0</span><span>RC enabled</span><span>1 loaded</span><span>Via Tailscale</span></div></article>
              <article class="host"><div class="hosttop"><span class="mark">M</span><div class="hosttitle"><b>maple-03</b><small>macOS · sample worker</small></div><span class="health"><i></i>Responding</span></div><div class="addresses"><div><span>LAN</span><code>192.0.2.23</code></div><div><span>TAILSCALE</span><code>198.51.100.23</code></div><div><span>ZEROTIER</span><code>203.0.113.23</code></div></div><div class="details"><span>Codex 0.134.0</span><span>RC enabled</span><span>— loaded</span><span>Via ZeroTier</span></div></article>
              <article class="host"><div class="hosttop"><span class="mark down">P</span><div class="hosttitle"><b>pine-04</b><small>Linux · sample worker</small></div><span class="health offline"><i></i>Unavailable</span></div><div class="addresses"><div><span>LAN</span><code>192.0.2.24</code></div><div><span>TAILSCALE</span><code>—</code></div><div><span>ZEROTIER</span><code>203.0.113.24</code></div></div><div class="details"><span>Codex —</span><span>RC unknown</span><span>0 loaded</span><button type="button" disabled aria-disabled="true">Start daemon</button></div></article>
            </div>
            <div class="note"><b>i</b>All addresses and host states above are fictional documentation data. Preview buttons are disabled and this page makes no API or network requests.</div>
          </section>
          <section class="activity" aria-label="Synthetic telemetry events"><div class="activityhead"><b>Recent telemetry</b><small>Content-free sample events</small></div><div class="row"><i></i><span>Fleet snapshot collected · cedar-01</span><small>12 sec ago</small></div><div class="row"><i></i><span>Codex turn completed · harbor-02</span><small>4 min ago</small></div></section>
          <footer class="footer"><span>FIELDNOTE · SYNTHETIC DOCUMENTATION VIEW</span><span>SSH host-key checking enabled</span></footer>
        </div>
      </main>
    </div>
    <div class="synthetic">SYNTHETIC FIXTURE</div>
  </body>
</html>
