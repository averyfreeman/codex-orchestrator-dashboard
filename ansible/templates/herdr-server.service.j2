[Unit]
Description=Herdr persistent terminal workspace server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH={{ ansible_facts['env']['HOME'] }}/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory={{ ansible_facts['env']['HOME'] }}
ExecStart={{ ansible_facts['env']['HOME'] }}/.local/bin/herdr server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
